---
import type { BlockOf, HierarchicalBlock } from "../../lib/wp/types";
import { stripNestedLists } from "../../lib/richtext/strip";
import RichText from "../../lib/richtext/RichText.astro";
import Self from "./CoreList.astro";

interface Props {
  block: BlockOf<"CoreList">;
  /** Rendered inside a parent list item — hollow-dot marker, tighter margin. */
  nested?: boolean;
}
const { block, nested = false } = Astro.props;
type ListItem = BlockOf<"CoreListItem">;
type NestedList = BlockOf<"CoreList">;
const isItem = (b: HierarchicalBlock): b is ListItem =>
  b.__typename === "CoreListItem";
const isList = (b: HierarchicalBlock): b is NestedList =>
  b.__typename === "CoreList";
const items = block.innerBlocks.filter(isItem);
const List = block.attributes.ordered ? "ol" : "ul";
// Drawn markers via Tailwind arbitrary variants: solid primary dots for
// bullets, primary numerals for ordered, small hollow dots when nested.
const MARKER_BASE =
  "[&>li]:relative [&>li]:pl-6 [&>li]:leading-relaxed";
const DOT_MARKER =
  "[&>li::before]:content-[''] [&>li::before]:absolute [&>li::before]:left-0.5 [&>li::before]:top-[0.62em] [&>li::before]:h-2 [&>li::before]:w-2 [&>li::before]:rounded-full [&>li::before]:bg-primary";
const NUMERAL_MARKER =
  "[counter-reset:list-item] [&>li::before]:content-[counter(list-item)] [&>li::before]:[counter-increment:list-item] [&>li::before]:absolute [&>li::before]:left-0 [&>li::before]:top-[0.1em] [&>li::before]:text-[0.95em] [&>li::before]:font-bold [&>li::before]:text-primary";
const NEST_DOT_MARKER =
  "[&>li::before]:content-[''] [&>li::before]:absolute [&>li::before]:left-0.5 [&>li::before]:top-[0.68em] [&>li::before]:h-1.5 [&>li::before]:w-1.5 [&>li::before]:rounded-full [&>li::before]:bg-transparent [&>li::before]:border-2 [&>li::before]:border-primary";
const marker = nested
  ? NEST_DOT_MARKER
  : block.attributes.ordered
    ? NUMERAL_MARKER
    : DOT_MARKER;
// Nested content arrives two ways: bare items parented straight under an
// item, or a full nested CoreList node. Wrap the bare shape in a synthetic
// list so the same recursive renderer styles every level, however deep.
const synthetic = (parentId: string, children: ListItem[]): NestedList => ({
  __typename: "CoreList",
  name: "core/list",
  clientId: `${parentId}-synthetic`,
  parentClientId: parentId,
  attributes: { ordered: false },
  innerBlocks: children,
});
const listsOf = (item: ListItem) => item.innerBlocks.filter(isList);
const bareItemsOf = (item: ListItem) => item.innerBlocks.filter(isItem);
---

{
  items.length > 0 && (
    <List
      class={`list-none space-y-2.5 p-0 ${nested ? "mt-2" : "my-4"} ${MARKER_BASE} ${marker}`}
    >
      {items.map((item) => (
        <li>
          <RichText html={stripNestedLists(item.attributes.content ?? "")} />
          {listsOf(item).map((sub) => (
            <Self block={sub} nested />
          ))}
          {bareItemsOf(item).length > 0 && (
            <Self block={synthetic(item.clientId, bareItemsOf(item))} nested />
          )}
        </li>
      ))}
    </List>
  )
}
