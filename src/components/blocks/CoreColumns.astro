---
import type { BlockOf } from "../../lib/wp/types";
import CoreColumn from "./CoreColumn.astro";

interface Props {
  block: BlockOf<"CoreColumns">;
}
const { block } = Astro.props;
const columns = block.innerBlocks.filter(
  (b): b is BlockOf<"CoreColumn"> => b.__typename === "CoreColumn",
);
const colsClass =
  {
    1: "grid-cols-1",
    2: "grid-cols-1 md:grid-cols-2",
    3: "grid-cols-1 md:grid-cols-3",
    4: "grid-cols-1 md:grid-cols-4",
  }[Math.min(columns.length, 4)] ?? "grid-cols-1 md:grid-cols-2";
---

{
  columns.length > 0 && (
    <div class={`my-6 grid gap-4${colsClass}`}>
      {columns.map((col) => (
        <CoreColumn block={col} />
      ))}
    </div>
  )
}
