---
import type { BlockOf } from "../../lib/wp/types";

interface Props {
  block: BlockOf<"CoreReadMore">;
}
const { block } = Astro.props;
const { content } = block.attributes;
---

<div
  class="my-8 flex items-center gap-4 text-muted-foreground transition-colors hover:text-primary"
>
  <span class="h-px flex-1 bg-border"></span>
  <span class="text-sm uppercase tracking-wide">{content || "Read more"}</span>
  <span class="h-px flex-1 bg-border"></span>
</div>
