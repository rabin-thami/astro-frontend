---
import type { BlockOf } from "../../lib/wp/types";

interface Props {
  block: BlockOf<"CoreMore">;
}
const { block } = Astro.props;
const { customText } = block.attributes;
---

<div class="my-8 flex items-center gap-4 text-muted-foreground">
  <span class="h-px flex-1 bg-border"></span>
  <span class="text-sm uppercase tracking-wide"
    >{customText || "Read more"}</span
  >
  <span class="h-px flex-1 bg-border"></span>
</div>
