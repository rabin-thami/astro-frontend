---
import type { BlockOf } from "../../lib/wp/types";
import RichText from "../../lib/richtext/RichText.astro";

interface Props {
  block: BlockOf<"CoreAudio">;
}

const { block } = Astro.props;
const { src, caption, autoplay, loop } = block.attributes;
---

{
  src && (
    <figure class="my-6">
      <div
        class="flex items-center gap-3 rounded-md border border-border bg-card p-3 sm:gap-4 sm:p-4"
        data-player
      >
        <button
          type="button"
          class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-primary text-primary-foreground shadow-sm transition-transform duration-150 ease-out hover:bg-primary/90 active:scale-95 motion-reduce:transition-none"
          data-play
          aria-label="प्ले गर्नुहोस्"
        >
          <svg data-icon="play" class="h-5 w-5 translate-x-px" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v13.72L19 12 8 5.14z" />
          </svg>
          <svg data-icon="pause" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
          </svg>
        </button>
        <div class="min-w-0 flex-1">
          <div
            class="cursor-pointer py-2"
            data-seek
            role="slider"
            aria-label="अडियो सीक"
            aria-valuemin="0"
            aria-valuemax="0"
            aria-valuenow="0"
            tabindex="0"
          >
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
              <div class="h-full w-0 rounded-full bg-primary" data-fill />
            </div>
          </div>
          <div class="mt-1 flex justify-between text-xs tabular-nums text-muted-foreground">
            <span data-current>0:00</span>
            <span data-duration>0:00</span>
          </div>
        </div>
      </div>
      <audio
        class="hidden"
        preload="metadata"
        src={src}
        autoplay={autoplay || undefined}
        loop={loop || undefined}
        data-audio
      />
      {caption && (
        <figcaption class="text-muted-foreground mt-2 text-center text-sm">
          <RichText html={caption} />
        </figcaption>
      )}
    </figure>
  )
}

<script>
  const fmt = (s: number) =>
    `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

  document.querySelectorAll<HTMLElement>("[data-player]").forEach((player) => {
    const audio = player
      .closest("figure")
      ?.querySelector<HTMLAudioElement>("audio[data-audio]");
    if (!audio) return;

    const playBtn = player.querySelector<HTMLButtonElement>("[data-play]")!;
    const iconPlay = player.querySelector<SVGElement>('[data-icon="play"]')!;
    const iconPause = player.querySelector<SVGElement>('[data-icon="pause"]')!;
    const seek = player.querySelector<HTMLElement>("[data-seek]")!;
    const fill = player.querySelector<HTMLElement>("[data-fill]")!;
    const current = player.querySelector<HTMLElement>("[data-current]")!;
    const duration = player.querySelector<HTMLElement>("[data-duration]")!;

    const setPlaying = (playing: boolean) => {
      iconPlay.classList.toggle("hidden", playing);
      iconPause.classList.toggle("hidden", !playing);
      playBtn.setAttribute("aria-label", playing ? "रोक्नुहोस्" : "प्ले गर्नुहोस्");
    };

    playBtn.addEventListener("click", () => {
      if (audio.paused) {
        // One clip at a time — silence every other player first.
        document
          .querySelectorAll<HTMLAudioElement>("audio[data-audio]")
          .forEach((a) => a !== audio && a.pause());
        audio.play();
      } else {
        audio.pause();
      }
    });

    audio.addEventListener("play", () => setPlaying(true));
    audio.addEventListener("pause", () => setPlaying(false));
    audio.addEventListener("ended", () => {
      setPlaying(false);
      fill.style.width = "0%";
      current.textContent = "0:00";
    });

    const syncTime = () => {
      if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      fill.style.width = `${pct}%`;
      current.textContent = fmt(audio.currentTime);
      seek.setAttribute("aria-valuemax", String(Math.round(audio.duration)));
      seek.setAttribute("aria-valuenow", String(Math.round(audio.currentTime)));
    };
    audio.addEventListener("timeupdate", syncTime);
    audio.addEventListener("loadedmetadata", () => {
      duration.textContent = fmt(audio.duration);
      seek.setAttribute("aria-valuemax", String(Math.round(audio.duration)));
    });

    // Seek by click or drag; pointer capture keeps the drag alive
    // even when the cursor leaves the rail.
    const seekTo = (clientX: number) => {
      if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
      const rect = seek.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      audio.currentTime = ratio * audio.duration;
      syncTime();
    };
    seek.addEventListener("pointerdown", (e) => {
      seek.setPointerCapture(e.pointerId);
      seekTo(e.clientX);
    });
    seek.addEventListener("pointermove", (e) => {
      if (seek.hasPointerCapture(e.pointerId)) seekTo(e.clientX);
    });

    // Keyboard scrubbing: arrows step 5s, Home/End jump to the ends.
    seek.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" ? 5 : e.key === "ArrowLeft" ? -5 : 0;
      if (step) {
        e.preventDefault();
        audio.currentTime = Math.min(
          audio.duration || 0,
          Math.max(0, audio.currentTime + step),
        );
        syncTime();
      } else if (e.key === "Home" || e.key === "End") {
        e.preventDefault();
        audio.currentTime = e.key === "Home" ? 0 : audio.duration || 0;
        syncTime();
      }
    });
  });
</script>
