---
import { Image } from "astro:assets";
import SafeImage from "../ui/SafeImage.astro";
import noImage from "../../assets/no-image-placeholder.png";
import type { WPCardPost } from "../../lib/graphql/queries/getPostsByCategory";
import { PROVINCES, resolveProvinceSlug } from "../../lib/wp/provinces";
import SmartLink from "../ui/SmartLink.astro";
import CardSideBySide from "../cards/CardSideBySide.astro";
import CardThumbnail from "../cards/CardThumbnail.astro";

interface Props {
  /** WP category slug from ?province= (validated, '__all__' default). */
  selected?: string;
  /** Main + popular feeds — fetched by the page in one combined batch. */
  posts: WPCardPost[];
  popular: WPCardPost[];
}

const MOBILE_MAIN_LIMIT = 5;
const MOBILE_POPULAR_LIMIT = 3;

const NEPALI_DIGITS = ["०", "१", "२", "३", "४", "५", "६", "७", "८", "९"];
const toNepaliDigits = (value: number): string =>
  value
    .toString()
    .split("")
    .map((ch) => (/^\d$/.test(ch) ? NEPALI_DIGITS[Number(ch)] : ch))
    .join("");

const { selected, posts, popular } = Astro.props;
// SSR picker: only the visible province is queried (the reference fetches
// all seven upfront for instant client switching — traded for 7x fewer
// queries per the grill decision; ?province= re-renders server-side).
const active = resolveProvinceSlug(selected);

const [featured, ...rest] = posts;
let renderedCount = 0;
---

<section
  id="province"
  class="mt-10 space-y-6 px-4 sm:px-6 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_0.4fr] lg:gap-8 scroll-mt-24"
>
  <div class="space-y-5">
    <div
      class="flex flex-col gap-3 border-b-2 border-primary pb-2 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-3xl font-semibold font-khand text-primary">
          प्रदेश समाचार
        </h2>
        <SmartLink href="/province" aria-label="View all province news">
          <svg
            width="22"
            height="22"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="text-primary"
            aria-hidden="true"
            ><path
              fill-rule="evenodd"
              d="M7.21 14.77a.75.75 0 01-.02-1.06L11.17 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
              clip-rule="evenodd"></path></svg
          >
        </SmartLink>
      </div>
      <nav
        class="flex flex-wrap items-center gap-2"
        aria-label="Select province"
      >
        {
          PROVINCES.map((p) => {
            const isActive = active === p.slug;
            return (
              <a
                href={`?province=${p.slug}#province`}
                aria-label={`Province ${p.numeral}`}
                aria-current={isActive ? "page" : undefined}
                class={
                  isActive
                    ? "bg-primary text-primary-foreground flex h-9 min-w-9 items-center justify-center rounded-full px-2 text-sm font-semibold"
                    : "bg-primary/10 text-primary hover:bg-primary/20 flex h-9 min-w-9 items-center justify-center rounded-full px-2 text-sm font-semibold transition-colors"
                }
              >
                {p.numeral}
              </a>
            );
          })
        }
      </nav>
    </div>

    {
      posts.length === 0 || !featured ? (
        <p class="text-muted-foreground">
          No posts to display. Publish something in WordPress.
        </p>
      ) : (
        <div class="space-y-6">
          <CardSideBySide
            title={featured.title}
            href={featured.link}
            imageUrl={
              featured.featuredImage?.node.sourceUrl
            }
            imageWidth={featured.featuredImage?.node.mediaDetails?.width ?? undefined}
            imageHeight={featured.featuredImage?.node.mediaDetails?.height ?? undefined}
            imageAlt={featured.featuredImage?.node.altText ?? featured.title}
            excerpt={featured.excerpt ?? undefined}
            timestamp={featured.dateGmt}
            size="lg"
            imageClass="h-[350px] md:h-[400px] w-[350px] md:w-[450px]"
            titleClass="md:text-4xl"
          />

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {rest.map((post) => {
              const hideOnMobile = renderedCount++ >= MOBILE_MAIN_LIMIT - 1;
              return (
                <CardThumbnail
                  title={post.title}
                  href={post.link}
                  imageUrl={post.featuredImage?.node.sourceUrl}
                  imageWidth={post.featuredImage?.node.mediaDetails?.width ?? undefined}
                  imageHeight={post.featuredImage?.node.mediaDetails?.height ?? undefined}
                  imageAlt={post.featuredImage?.node.altText ?? ""}
                  timestamp={post.dateGmt}
                  layout="horizontal"
                  class={hideOnMobile ? "hidden sm:flex" : undefined}
                />
              );
            })}
          </div>
        </div>
      )
    }
  </div>
  <aside class="flex flex-col gap-4 self-start sticky top-20">
    <h2 class="text-3xl font-semibold font-khand text-primary">लोकप्रिय</h2>
    {
      popular.map((post, index) => (
        <SmartLink
          href={post.link}
          class={`group flex gap-4 justify-center items-center ${index >= MOBILE_POPULAR_LIMIT ? "hidden sm:flex" : ""}`}
        >
          <span class="text-primary/90 flex h-14 w-14 shrink-0 items-center justify-center rounded-full text-4xl font-bold">
            {toNepaliDigits(index + 1)}
          </span>
          {post.featuredImage?.node.sourceUrl ? (
            <div class="bg-muted relative h-24 w-24 shrink-0 overflow-hidden rounded">
              <SafeImage
                src={post.featuredImage.node.sourceUrl}
                alt={post.featuredImage.node.altText ?? ""}
                width={192}
                height={192}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          ) : (
            <div class="bg-muted relative h-24 w-24 shrink-0 overflow-hidden rounded">
              <Image src={noImage} alt="" width={192} height={192} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            </div>
          )}
          <h4 class="font-mukta text-foreground group-hover:text-primary line-clamp-3 min-w-0 flex-1 text-lg font-semibold transition-colors">
            {post.title}
          </h4>
        </SmartLink>
      ))
    }
  </aside>
</section>

<script>
  // Province picker without full-page reloads: intercept the ?province= links,
  // fetch the page, swap only the #province section, and push history.
  // Any failure falls back to normal navigation.
  const provinceCache = new Map<string, string>();

  async function showProvinceSection(
    url: string,
    push: boolean,
  ): Promise<void> {
    const current = document.getElementById("province");
    if (!current) {
      window.location.href = url;
      return;
    }
    try {
      current.style.opacity = "0.55";
      let html = provinceCache.get(url);
      if (!html) {
        const res = await fetch(url, { headers: { accept: "text/html" } });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        html = await res.text();
        provinceCache.set(url, html);
      }
      const next = new DOMParser()
        .parseFromString(html, "text/html")
        .getElementById("province");
      if (!next) throw new Error("section missing");
      current.replaceWith(next);
      if (push) history.pushState({ provinceUrl: url }, "", url);
      document.getElementById("province")?.scrollIntoView({ block: "start" });
    } catch {
      window.location.href = url;
    }
  }

  document.addEventListener("click", (e: MouseEvent) => {
    const target = e.target as Element | null;
    const anchor = target?.closest?.(
      'a[href*="?province="]',
    ) as HTMLAnchorElement | null;
    if (
      !anchor ||
      e.metaKey ||
      e.ctrlKey ||
      e.shiftKey ||
      e.altKey ||
      e.button !== 0
    )
      return;
    e.preventDefault();
    void showProvinceSection(anchor.href, true);
  });

  window.addEventListener("popstate", () => {
    void showProvinceSection(window.location.href, false);
  });
</script>
