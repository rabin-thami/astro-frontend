---
import {
  getLayout,
  type LogoConfig,
} from "../../lib/graphql/queries/getLayout";
import type { FooterConfig } from "../../lib/graphql/queries/getTheme";
import type { SvgComponent } from "astro/types";
import Logo from "./Logo.astro";
import FacebookIcon from "../../assets/social/facebook.svg";
import TwitterIcon from "../../assets/social/twitter.svg";
import YoutubeIcon from "../../assets/social/youtube.svg";
import InstagramIcon from "../../assets/social/instagram.svg";
import TiktokIcon from "../../assets/social/tiktok.svg";
import LinkedinIcon from "../../assets/social/linkedin.svg";

interface Props {
  footer?: FooterConfig;
}

const { footer } = Astro.props;
const f: FooterConfig = footer ?? {
  logoUrl: "",
  description: "",
  columns: [],
  publisherName: "",
  publisherAddress: "",
  regNo: "",
  email: "",
  phone: "",
  teamName: "",
  teamRole: "",
};

// Social links already render from the footer's SOCIAL-style column below
// (link titles map to brand icons via SOCIAL_ICONS). This round-button row
// stays empty until PatrikaOS exposes *profile URLs* — patrikaosSocial
// .networks lists share targets (facebook, x, whatsapp, viber, copy), not
// linkable profiles, so it can't feed this row yet.
const socials: Array<{
  network:
    "facebook" | "twitter" | "instagram" | "youtube" | "tiktok" | "linkedin";
  url: string;
}> = [];

const DEVELOPER_NAME = "Rabin Thami";
const DEVELOPER_URL = "https://www.rabinthami.com.np/";

const layout = Astro.locals.layout ?? (await getLayout());
const { logo } = layout;
// Footer-specific logo wins, header logo as fallback.
const brandLogo: LogoConfig = {
  url: f.logoUrl || logo.url,
  retina: f.logoUrl ? "" : logo.retina,
  text: logo.text,
  alt: logo.alt,
};
const brand = logo.text || "पत्रिका";
const description = f.description || "छिटो, तथ्यपूर्ण, डिजिटल समाचार।";
const year = new Date().getFullYear();
const hasCompany = f.publisherName || f.publisherAddress || f.regNo;
const hasContact = f.email || f.phone;
const hasTeam = !!f.teamName;
const columns = (f.columns ?? []).filter(
  (c) => c.title || (c.links ?? []).length > 0,
);

/** Turn a free-form value into an href when it looks linkable. */
function linkHref(value: string): string | null {
  const v = value.trim();
  if (/^https?:\/\//i.test(v) || /^mailto:|^tel:/i.test(v)) return v;
  if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return `mailto:${v}`;
  if (/^\+?[\d][\d\s\-()]{5,}$/.test(v))
    return `tel:${v.replace(/[^+\d]/g, "")}`;
  return null;
}

/** True for navigation-style values (URLs, site paths) as opposed to data text. */
function isNavValue(value: string): boolean {
  const v = value.trim();
  return (
    v !== "" &&
    (/^https?:\/\//i.test(v) || v.startsWith("/") || v.startsWith("#"))
  );
}

/** Backend link titles mapped to local brand icons (matched case-insensitively). */
const SOCIAL_ICONS: Record<string, SvgComponent> = {
  facebook: FacebookIcon,
  twitter: TwitterIcon,
  x: TwitterIcon,
  youtube: YoutubeIcon,
  instagram: InstagramIcon,
  tiktok: TiktokIcon,
  linkedin: LinkedinIcon,
};

function socialIcon(title: string): SvgComponent | null {
  return SOCIAL_ICONS[title.toLowerCase().replace(/[^a-z]/g, "")] ?? null;
}
---

<footer class="font-mukta mt-auto border-t border-border bg-background text-muted-foreground">
  <div class="mx-auto max-w-7xl px-4 pt-14 pb-10 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-[auto_1fr_1.5fr_auto]"
    >
      <div>
        {
          brandLogo.url ? (
            <a href="/" aria-label="Home">
              <Logo logo={brandLogo} />
            </a>
          ) : (
            <h3 class="font-mukta text-2xl font-bold tracking-tight text-primary">
              {brand}
            </h3>
          )
        }
        {
          description && (
            <p class="mt-3 line-clamp-2 text-base leading-relaxed text-muted-foreground">
              {description}
            </p>
          )
        }
        {
          socials.length > 0 && (
            <div class="mt-5 flex flex-wrap items-center gap-2">
              {socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.network}
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-muted text-muted-foreground transition-colors hover:border-primary hover:bg-primary hover:text-primary-foreground"
                >
                  {s.network === "facebook" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                    </svg>
                  )}
                  {s.network === "twitter" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  )}
                  {s.network === "instagram" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                    </svg>
                  )}
                  {s.network === "youtube" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                  )}
                  {s.network === "tiktok" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.93a8.16 8.16 0 0 0 4.77 1.52V7a4.85 4.85 0 0 1-1.84-.31z" />
                    </svg>
                  )}
                  {s.network === "linkedin" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        (hasCompany || hasContact) && (
          <div>
            <h4 class="font-mukta text-base font-semibold uppercase tracking-wider text-muted-foreground">
              प्रकाशक
            </h4>
            <div class="mt-4 space-y-2 text-[15px]">
              {f.publisherName && (
                <p class="font-semibold text-muted-foreground">{f.publisherName}</p>
              )}
              {f.publisherAddress && (
                <p class="text-muted-foreground leading-relaxed">
                  {f.publisherAddress}
                </p>
              )}
              {f.regNo && (
                <p class="text-xs text-muted-foreground/80">
                  दर्ता नं: {f.regNo}
                </p>
              )}
              {f.email && (
                <p class="flex items-start gap-2">
                  <span class="text-muted-foreground/70 select-none">✉</span>
                  <a
                    href={`mailto:${f.email}`}
                    class="text-muted-foreground transition-colors hover:text-primary break-all"
                  >
                    {f.email}
                  </a>
                </p>
              )}
              {f.phone && (
                <p class="flex items-start gap-2">
                  <span class="text-muted-foreground/70 select-none">☎</span>
                  <a
                    href={`tel:${f.phone.replace(/[^+\d]/g, "")}`}
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    {f.phone}
                  </a>
                </p>
              )}
            </div>
          </div>
        )
      }

      {
        hasTeam && (
          <div>
            <h4 class="font-mukta text-base font-semibold uppercase tracking-wider text-muted-foreground">
              टोली
            </h4>
            <ul class="mt-4 space-y-3 text-[15px]">
              <li class="flex items-center gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-xs font-semibold text-muted-foreground">
                  {f.teamName.charAt(0).toUpperCase()}
                </div>
                <div class="min-w-0">
                  <p class="font-semibold text-muted-foreground leading-tight">
                    {f.teamName}
                  </p>
                  {f.teamRole && (
                    <p class="text-xs text-muted-foreground leading-tight">
                      {f.teamRole}
                    </p>
                  )}
                </div>
              </li>
            </ul>
          </div>
        )
      }

      {
        columns.map((col) => {
          // Columns made purely of links (e.g. SOCIAL MEDIA) run in one row;
          // title:value data columns keep the WP grid stacking.
          const navList =
            col.links.length > 0 && col.links.every((l) => isNavValue(l.value));
          return (
            <div>
              {col.title && (
                <h4 class="font-mukta text-base font-semibold uppercase tracking-wider text-muted-foreground">
                  {col.title}
                </h4>
              )}
              {navList ? (
                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3 text-[15px]">
                  {col.links.map((link) => {
                    const Icon = socialIcon(link.title);
                    const href = link.value.trim();
                    const external = href.startsWith("http");
                    return Icon ? (
                      <a
                        href={href}
                        aria-label={link.title}
                        {...(external
                          ? { target: "_blank", rel: "noopener noreferrer" }
                          : {})}
                        class="transition-opacity hover:opacity-75"
                      >
                        <Icon class="h-5 w-5" />
                      </a>
                    ) : (
                      <a
                        href={href}
                        {...(external
                          ? { target: "_blank", rel: "noopener noreferrer" }
                          : {})}
                        class="truncate text-muted-foreground transition-colors hover:text-primary"
                      >
                        {link.title || link.value}
                      </a>
                    );
                  })}
                </div>
              ) : (
                <div
                  class="mt-4 grid gap-x-6 gap-y-2 text-[15px]"
                  style={`grid-template-columns: repeat(${col.gridCols}, minmax(0, 1fr));${col.gridRows > 0 ? ` grid-template-rows: repeat(${col.gridRows}, auto);` : ""}`}
                >
                  {col.links.map((link) => {
                    const href = linkHref(link.value);
                    return (
                      <p class="text-muted-foreground leading-relaxed">
                        {link.title && (
                          <span class="font-semibold text-muted-foreground">
                            {link.title}
                            {link.value ? ":" : ""}
                          </span>
                        )}{" "}
                        {link.value &&
                          (href ? (
                            <a
                              href={href}
                              {...(href.startsWith("http")
                                ? {
                                    target: "_blank",
                                    rel: "noopener noreferrer",
                                  }
                                : {})}
                              class="transition-colors hover:text-primary break-all"
                            >
                              {link.value}
                            </a>
                          ) : (
                            <span>{link.value}</span>
                          ))}
                      </p>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </div>

  <div class="border-t border-border bg-background/50">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-5 sm:flex-row sm:px-6 lg:px-8"
    >
      <p class="text-sm text-muted-foreground">
        © {year}
        {" "}{brand}. सर्वाधिकार सुरक्षित।
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
        <p class="text-muted-foreground">
          Developed by :{" "}
          <a
            href={DEVELOPER_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-muted-foreground transition-colors hover:text-primary"
          >
            {DEVELOPER_NAME}
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
