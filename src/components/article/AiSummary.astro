---
/**
 * AI Summary section: standalone node below the featured image. The raw
 * summary may arrive as newline-separated points, <li> items or <p>
 * blocks — split defensively into bullets; a single paragraph renders as
 * one bullet. Rendered only when the module is on AND the post has a
 * summary — the caller (ArticleHeader) enforces both.
 */
interface Props {
  summary: string;
}

const { summary } = Astro.props;

const points = summary
  .replace(/<br\s*\/?>/gi, "\n")
  .split(/<\/li>|<\/p>|\n/gi)
  .map((s) =>
    s
      .replace(/<[^>]+>/g, "")
      .replace(/^[•·▪–—\-*]+\s*/, "")
      .trim(),
  )
  .filter(Boolean);
---

{
  points.length > 0 && (
    <section
      class="my-8 rounded-md border border-border bg-card p-5 sm:p-6"
      aria-label="News Summary"
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="#0b5cad"
            d="M16 1c.6 4.5 2.3 6.2 6.8 6.8-4.5.6-6.2 2.3-6.8 6.8-.6-4.5-2.3-6.2-6.8-6.8 4.5-.6 6.2-2.3 6.8-6.8z"
          />
          <path
            fill="#e11d48"
            d="M5 10c.4 2.8 1.4 3.8 4.2 4.2-2.8.4-3.8 1.4-4.2 4.2-.4-2.8-1.4-3.8-4.2-4.2 2.8-.4 3.8-1.4 4.2-4.2z"
          />
          <path
            fill="#9ca3af"
            d="M13 16.5c.25 1.75.9 2.4 2.65 2.65-1.75.25-2.4.9-2.65 2.65-.25-1.75-.9-2.4-2.65-2.65 1.75-.25 2.4-.9 2.65-2.65z"
          />
        </svg>
        <h2 class="font-mukta text-xl font-bold text-foreground">
          News Summary
        </h2>
      </div>
      <div class="mt-3 flex items-center" aria-hidden="true">
        <span class="h-0.5 w-16 rounded-full bg-primary" />
        <span class="h-px flex-1 bg-border" />
      </div>
      <ul class="ml-5 mt-4 list-disc space-y-3 marker:text-foreground">
        {points.map((point) => (
          <li class="font-mukta text-lg leading-relaxed text-foreground font-medium">
            {point}
          </li>
        ))}
      </ul>
      <p class="font-mukta text-muted-foreground mt-4 text-sm">
        Generated by FriendShip Khabar AI. Editorially reviewed.
      </p>
    </section>
  )
}
