---
// On-demand like every other renderable route: the license gate rewrites
// on-demand pages here at runtime, which Astro forbids for prerendered
// (static) targets.
export const prerender = false;
// ponytail: placeholder — point this at the real PatrikaOS purchase page.
const PURCHASE_URL = "https://patrikaos.com/purchase";
const domain = Astro.url.searchParams.get("domain") ?? "";
---

<!doctype html>
<html lang="ne">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>साइट सक्रियकरण आवश्यक छ</title>
    <style>
      :root {
        --brand: #0b5cad;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #f6f7f9;
        color: #16181d;
        font-family: "Mukta", "Noto Sans Devanagari", system-ui, sans-serif;
        padding: 1.5rem;
      }
      .card {
        max-width: 30rem;
        width: 100%;
        background: #fff;
        border: 1px solid #e4e7ec;
        border-radius: 12px;
        padding: 2.5rem 2rem;
        text-align: center;
        box-shadow: 0 1px 3px rgb(0 0 0 / 6%);
      }
      h1 {
        font-size: 1.25rem;
        margin: 0 0 0.5rem;
      }
      p {
        color: #5a6072;
        font-size: 0.95rem;
        line-height: 1.7;
        margin: 0 0 1.25rem;
      }
      a {
        display: inline-block;
        background: var(--brand);
        color: #fff;
        text-decoration: none;
        padding: 0.6rem 1.4rem;
        border-radius: 8px;
        font-weight: 600;
      }
      code {
        background: #f0f1f4;
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        font-size: 0.85em;
      }
      .secondary a {
        display: inline;
        background: none;
        color: var(--brand);
        padding: 0;
        font-weight: 500;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>लाइसेन्स सक्रिय छैन</h1>
      <p>
        यो वेबसाइटको PatrikaOS लाइसेन्स सक्रिय छैन वा म्याद सकिएको छ। साइट
        चलाउन कृपया लाइसेन्स किन्नुहोस् वा WP एडमिनमा आफ्नो key सक्रिय गर्नुहोस्।
      </p>
      <p>License required{domain ? ` for ${domain}` : ""}.</p>
      <a href={PURCHASE_URL}>Key किन्नुहोस् (Purchase a key)</a>
      <p class="secondary">
        <a href="/wp-admin/admin.php?page=patrikaos#license">Already have a key? Activate in WP admin →</a>
      </p>
    </main>
  </body>
</html>
