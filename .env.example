# WP GraphQL endpoint (local docker)
WORDPRESS_GRAPHQL_URL=http://localhost:8080/graphql
# Shared secret sent as X-PatrikaOS-Key (must match PatrikaOS webhook_secret)
GRAPHQL_SECRET=
# Cache-phase (later): Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Must match PatrikaOS webhook_secret
REVALIDATE_SECRET=
# PatrikaOS license server (Cloudflare Worker base URL, no trailing slash)
LICENSE_SERVER_URL=
